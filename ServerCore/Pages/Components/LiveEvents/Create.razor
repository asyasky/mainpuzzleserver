                <ValidationMessage For="() => LiveEvent.OpeningReminderOffset" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="closingreminderoffset" class="form-label">ClosingReminderOffset:</label> 
                <InputText id="closingreminderoffset" @bind-Value="LiveEvent.ClosingReminderOffset" class="form-control" /> 
                <ValidationMessage For="() => LiveEvent.ClosingReminderOffset" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="firstreminderoffset" class="form-label">FirstReminderOffset:</label> 
                <InputText id="firstreminderoffset" @bind-Value="LiveEvent.FirstReminderOffset" class="form-control" /> 
                <ValidationMessage For="() => LiveEvent.FirstReminderOffset" class="text-danger" /> 
